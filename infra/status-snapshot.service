[Unit]
Description=B205 public service status snapshot
After=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/lib/s15p31b205/status-snapshot.py
Environment=DOCKER_CONFIG=/nonexistent
RuntimeDirectory=s15p31b205-status
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/run/s15p31b205-status
