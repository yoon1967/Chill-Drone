<?xml version="1.0"?>
<launch>
  <!-- numpy/OpenBLAS busy-waits on every core by default; at 1x replay the floor filter alone used
       128% CPU and the depth node dropped half the frames. Each Python node needs one BLAS thread. -->
  <env name="OPENBLAS_NUM_THREADS" value="1"/>
  <!-- Build/replay defaults never start the hardware driver or command a drone. -->
  <arg name="hardware" default="false"/>
  <arg name="backend" default="onnx"/>
  <!-- da_v2_metric_indoor_small (metric) tracks approaching obstacles; sc_depth_v2_nyu (relative) did not. -->
  <arg name="depth_model" default="da_v2_metric_indoor_small"/>
  <!-- Empty uses the verified path of depth_model. -->
  <arg name="onnx_model" default=""/>
  <!-- Ground RANSAC inlier band in depth units: 0.001 relative SC units is about 6 mm; metric DA-V2 uses 1 cm. -->
  <arg name="ground_distance_threshold" default="$(eval 0.001 if arg('depth_model') == 'sc_depth_v2_nyu' else 0.01)"/>
  <arg name="checkpoint" default="/models/sc_depth_v2_nyu.ckpt"/>
  <arg name="device" default="cuda"/>
  <!-- ONNX depth device; cuda fails loudly instead of silently using CPU. -->
  <arg name="depth_device" default="cuda"/>
  <arg name="camera_info" default="$(find scale_recovery)/config/camera_info.yaml"/>
  <!-- ORB-SLAM2 RGB-D uses bf = virtual baseline x fx; close/far depth threshold = ThDepth x baseline.
       0.075 m follows ORB-SLAM2's RGB-D examples (bf 40 at fx 535); 0 disables depth in tracking. -->
  <arg name="orb_virtual_baseline_m" default="0.075"/>
  <node pkg="mona_integration" type="calibration_publisher.py" name="camera_calibration" required="true" output="screen">
    <param name="camera_info" value="$(arg camera_info)"/>
    <param name="orb_virtual_baseline_m" value="$(arg orb_virtual_baseline_m)"/>
  </node>
  <include if="$(arg hardware)" file="$(find rmtt_driver)/launch/rmtt_bringup.launch"/>
  <node if="$(eval arg('backend') == 'onnx')" pkg="mona_integration" type="onnx_depth.py" name="sc_depth_pl" output="screen" required="true">
    <param name="model" value="$(arg onnx_model)"/>
    <param name="model_kind" value="$(arg depth_model)"/>
    <param name="device" value="$(arg depth_device)"/>
  </node>
  <node if="$(eval arg('backend') == 'pytorch')" pkg="sc_depth_pl_ros" type="sc_depth_node.py" name="sc_depth_pl" output="screen" required="true">
    <param name="checkpoint" value="$(arg checkpoint)"/>
    <param name="device" value="$(arg device)"/>
    <param name="sub_color_img" value="/tello/image_raw"/>
    <param name="pub_color_img" value="/sc_depth_pl/color/image_raw"/>
    <param name="pub_depth_img" value="/sc_depth_pl/depth/image_raw"/>
  </node>
  <node pkg="scale_recovery" type="info_pub_planner.py" name="info_pub" output="screen">
    <param name="camera_info_path" value="$(arg camera_info)"/>
    <param name="algorithm_name" value="SC-Depth"/>
  </node>
  <node pkg="nodelet" type="nodelet" name="nodelet_manager" args="manager"/>
  <node pkg="nodelet" type="nodelet" name="depth2pcl" args="load depth_image_proc/point_cloud_xyz nodelet_manager">
    <remap from="camera_info" to="/sync/camera_info"/>
    <remap from="image_rect" to="/sync/depth"/>
    <remap from="points" to="/sync/pcl_cam"/>
  </node>
  <node pkg="scale_recovery" type="ground_seg_planner" name="ground_seg_planner">
    <param name="algorithm_name" value="SC-Depth"/>
    <param name="distance_threshold" value="$(arg ground_distance_threshold)"/>
  </node>
  <node pkg="scale_recovery" type="scale_recovery_planner.py" name="scale_recovery"/>
  <include file="$(find mona_integration)/launch/orb_rgbd.launch"/>
  <!-- Planner map intrinsics (unchanged upstream values), shared with the floor filter. -->
  <arg name="map_fx" value="631.304382"/><arg name="map_fy" value="643.417053"/>
  <arg name="map_cx" value="320.982631"/><arg name="map_cy" value="243.577051"/>
  <!-- The map frame is the first (pitched) camera pose, so the real floor becomes a slope that rises
       into flight height a few metres ahead. Remove floor pixels from the planner's depth only. -->
  <arg name="floor_filter" default="true"/>
  <node if="$(arg floor_filter)" pkg="mona_integration" type="floor_filter.py" name="floor_filter" output="screen" required="true">
    <remap from="~depth_in" to="/sync/depth_metric"/>
    <remap from="~depth_out" to="/mona/depth_planning"/>
    <param name="fx" value="$(arg map_fx)"/><param name="fy" value="$(arg map_fy)"/>
    <param name="cx" value="$(arg map_cx)"/><param name="cy" value="$(arg map_cy)"/>
    <param name="band_m" value="0.15"/>
  </node>
  <include file="$(find plan_manage)/launch/kino_algorithm.xml">
    <arg name="map_size_x_" value="12.0"/><arg name="map_size_y_" value="8.0"/><arg name="map_size_z_" value="3.5"/>
    <arg name="odometry_topic" value="/sync/tf_odom"/>
    <arg name="camera_pose_topic" value="/sync/camera_pose"/>
    <arg name="depth_topic" value="$(eval '/mona/depth_planning' if str(arg('floor_filter')).lower() == 'true' else '/sync/depth_metric')"/>
    <arg name="cloud_topic" value="/mona/unused_cloud"/>
    <arg name="cx" value="$(arg map_cx)"/><arg name="cy" value="$(arg map_cy)"/>
    <arg name="fx" value="$(arg map_fx)"/><arg name="fy" value="$(arg map_fy)"/>
    <arg name="max_vel" value="0.2"/><arg name="max_acc" value="0.25"/>
    <arg name="flight_type" value="1"/><arg name="point_num" value="1"/>
    <arg name="point0_x" value="4.0"/><arg name="point0_y" value="0.0"/><arg name="point0_z" value="0.8"/>
    <arg name="point1_x" value="0.0"/><arg name="point1_y" value="0.0"/><arg name="point1_z" value="0.8"/>
    <arg name="point2_x" value="0.0"/><arg name="point2_y" value="0.0"/><arg name="point2_z" value="0.8"/>
  </include>
  <!-- Keep conservative inflation; the upstream example's 0.009m is not used. -->
  <param name="fast_planner_node/sdf_map/obstacles_inflation" value="0.45"/>
  <!-- From rest the first search step moves at most 0.5 x max_vel x init_max_tau = 0.08 m (0.2 m/s, 0.8 s),
       and only when max_acc >= max_vel / init_max_tau (0.25). With 0.08 m/s^2 and 0.1 m cells every child
       stayed in the start cell ("open set empty" at iteration 1). A 0.05 m search grid keeps 0.2 m/s. -->
  <param name="fast_planner_node/search/resolution_astar" value="0.05"/>
  <node pkg="plan_manage" type="traj_server" name="traj_server" output="screen">
    <remap from="/position_cmd" to="/planning/pos_cmd"/>
    <remap from="/odom_world" to="/sync/tf_odom"/>
    <param name="traj_server/time_forward" value="1.5"/>
  </node>
  <node pkg="mav_controller" type="pid_controller.py" name="pid_controller" output="screen">
    <!-- Full controller runs, but output is a candidate, never a hardware command. -->
    <remap from="/tello/cmd_vel" to="/mona/candidate_cmd_vel"/>
  </node>
</launch>
